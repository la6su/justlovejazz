{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUnusedParameters": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es6",
    "module": "esnext",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./src/ts/types"],
    "types": ["three", "cannon"],
    "lib": ["dom", "es6", "es2015", "es2016", "es2017"],
    "outDir": "dist",
    "declaration": true,
    "declarationDir": "dist",
    "sourceMap": true,
    "inlineSources": true,
    "removeComments": false,
    "preserveConstEnums": true,
    "isolatedModules": true
  },
  "include": [
    "src/ts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*Test*.ts"
  ],
  "ts-node": {
    "transpileOnly": true,
    "experimentalModules": true,
    "compiler": "typescript"
  },
  "files": [
    "src/ts/main.ts"
  ],
  "compileOnSave": true
}
