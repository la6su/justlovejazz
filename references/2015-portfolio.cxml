<document index="90">
<source>app/src/less/mixins/clear.less</source>
<document_content>
.clear {
  *zoom: 1;
  &:before,
  &:after {
    display: table;

    content: ' ';
  }
  &:after {
    clear: both;
  }
}

</document_content>
</document>
