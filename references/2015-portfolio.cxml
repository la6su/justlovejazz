  <link rel="icon" type="image/png" href="./app/public/favicons/favicon-192x192.png" sizes="192x192">
  <link rel="icon" type="image/png" href="./app/public/favicons/favicon-160x160.png" sizes="160x160">
  <link rel="icon" type="image/png" href="./app/public/favicons/favicon-96x96.png" sizes="96x96">
