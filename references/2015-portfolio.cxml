  <link rel="icon" type="image/png" href="./app/public/favicons/favicon-32x32.png" sizes="32x32">
  <meta name="msapplication-TileColor" content="#2d89ef">
  <meta name="msapplication-TileImage" content="./app/public/favicons/mstile-144x144.png">
