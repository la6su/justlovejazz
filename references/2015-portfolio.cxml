.heads {
  background-color: #0a0a0a;
}

</document_content>
</document>
<document index="85">
<source>app/src/less/layout/tails.less</source>
<document_content>
@import '../mixins/clear';

// general
.tails {
  background-color: #fff;
}

// sections
.tails__section {
  position: relative;

  max-width: 600px;
  margin: 0 auto;
  padding: 50px;

  .clear;
  will-change: transform;
}

.tails__section:last-child {
  padding-bottom: 200px;
}

.tails__link {
  font-size: 24px;

  display: block;

  margin: 40px 0;

  color: #121212;
}

.tails__section__el {
  position: relative;
}

.tails__column {
  float: left;

  width: 50%;
}

.tails__column--left {
  float: left;
}

.tails__column--right {
  float: right;
}

.tails__column__container--left {
  padding-right: 50px;
}

.tails__column__container--right {
  padding-left: 50px;
}

@media screen and (max-width: 600px) {
  .tails__column {
    float: none;

    width: 100%;
  }

  .tails__column__container {
    padding: 0;
  }
}

</document_content>
</document>
<document index="86">
<source>app/src/less/layout/trigger.less</source>
<document_content>
// general
.trigger {
  position: fixed;
  z-index: 4;
  bottom: 0;

  width: 100%;
  height: 100px;

  cursor: pointer;
  text-align: center;
}

.trigger__info {
  position: absolute;
  z-index: 10;

  width: 100%;
  padding: 10px 0;

  text-align: center;
}

.trigger__info--arrow {
  bottom: 0;
  left: 50%;

  width: 26px;
  height: 20px;
  margin-left: -13px;

  opacity: .5;
  color: #fff;
}

.trigger__info--heads {
  bottom: 0;

  color: #fff;
}

.trigger__info--tails {
  bottom: -77px;

  color: #0a0a0a;
}

.trigger__info__text {
  position: relative;
  z-index: 2;
}

.trigger__info__bg {
  position: absolute;
  z-index: 1;
  top: 0;
  left: 0;

  width: 100%;
  height: 100%;
}

.trigger__info__bg--tails {
  /* IE9 SVG, needs conditional override of 'filter' to 'none' */
  background: url(data:image/svg+xml;base64,);
  background:    -moz-linear-gradient(top, rgba(255,255,255,1) 0%, rgba(255,255,255,1) 36%, rgba(255,255,255,0) 100%); /* FF3.6+ */
  background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,rgba(255,255,255,1)), color-stop(36%,rgba(255,255,255,1)), color-stop(100%,rgba(255,255,255,0))); /* Chrome,Safari4+ */
  background: -webkit-linear-gradient(top, rgba(255,255,255,1) 0%,rgba(255,255,255,1) 36%,rgba(255,255,255,0) 100%); /* Chrome10+,Safari5.1+ */
  background:      -o-linear-gradient(top, rgba(255,255,255,1) 0%,rgba(255,255,255,1) 36%,rgba(255,255,255,0) 100%); /* Opera 11.10+ */
  background:     -ms-linear-gradient(top, rgba(255,255,255,1) 0%,rgba(255,255,255,1) 36%,rgba(255,255,255,0) 100%); /* IE10+ */
  background:         linear-gradient(to bottom, rgba(255,255,255,1) 0%,rgba(255,255,255,1) 36%,rgba(255,255,255,0) 100%); /* W3C */
  background-color: #fff;

  filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#ffffff', endColorstr='#00ffffff',GradientType=0 ); /* IE6-8 */
}

</document_content>
</document>
