<document index="96">
<source>app/src/less/objects2D/help.less</source>
<document_content>
@import '../mixins/inlineBlock';

// general
.help {
  position: fixed;
  z-index: 10;
  top: 0;
  left: 0;

  display: none;

  width: 100%;
  height: 100%;

  opacity: 0;
  background-color: #0a0a0a;
}

// sections
.help__layout {
  margin-bottom: 130px;
}

.help__navigation {
  margin-bottom: 100px;

  text-align: center;
}

// positionning
.help__navigation {
  .mouse,
  .keys {
    margin: 0 20px;

    .inline-block;
  }
}

// button
.help__quit {
  position: absolute;
  top: 20px;
  left: 30px;

  width: 25px;
  height: 20px;

  cursor: pointer;
}

</document_content>
</document>
<document index="97">
<source>app/src/less/objects2D/keys.less</source>
<document_content>
@keyThickBorder: 2px;
@keySize: 48px;
@keyMargin: 10px;

.keys {
  position: relative;
  top: 20px;

  width: (3 * @keySize) + (2 * @keyMargin) + (2 * @keyThickBorder);
  height: (2 * @keySize) + @keyMargin + (2 * @keyThickBorder);
}

.key {
  position: absolute;

  width: @keySize;
  height: @keySize;

  opacity: .2;
  border: @keyThickBorder solid #fff;

  .border-radius(6px);
}

.key--left {
  bottom: 0;
  left: 0;
}

.key--right {
  bottom: 0;
  left: 2 * (@keySize + @keyMargin);
}

.key--bottom {
  bottom: 0;
  left: @keySize + @keyMargin;
}

.key--top {
  bottom: @keySize + @keyMargin;
  left: @keySize + @keyMargin;
}

.key__triangle {
  position: absolute;
  top: 50%;
  left: 50%;

  margin-top: -5px;
  margin-left: -5px;

  background-image: url('../../../public/img/sprite-icons.png');
}

.key__triangle--top,
.key__triangle--bottom {
  width: 11px;
  height: 8px;
}

.key__triangle--left,
.key__triangle--right {
  width: 8px;
  height: 11px;
}

.key__triangle--left {
  background-position: 17px 0;
}

.key__triangle--right {
  background-position: 9px 0;
}

.key__triangle--top {
  background-position: 0 0;
  background-position: 0 -1px;
}

.key__triangle--bottom {
  background-position: 0 -10px;
}

</document_content>
</document>
<document index="98">
<source>app/src/less/objects2D/layout.less</source>
<document_content>
@import '../mixins/borderRadius';

@layoutThickBorder: 2px;
@layoutThinBorder: 1px;

.layout {
  position: relative;

  max-width: 150px;
  margin: 0 auto;
}

.layout__mouse {
  position: absolute;
  z-index: 3;
  top: 50%;
  left: 50%;

  width: 16px;
  height: 16px;
  margin-left: -8px;
}

.layout__mouse__icon {
  position: absolute;
  z-index: 2;
  top: 9px;
  left: 9px;

  width: 100%;
  height: 100%;

  background-image: url('../../../public/img/sprite-icons.png');
  background-position: 17px -13px;
}

.layout__mouse__click {
  position: absolute;
  top: 50%;
  left: 50%;

  width: 0;
  height: 0;
  margin-top: 0;
  margin-left: 0;

  opacity: 1;
  background-color: #fff;

  .border-radius(50%);
}

.layout__frame {
  position: relative;
  z-index: 2;

  height: 110px - (@layoutThickBorder * 2);
  margin: 0 -15px;

  border: @layoutThickBorder solid #fff;
}

.layout__parts {
  position: absolute;
  top: 0;

  width: 100%;
  height: 100%;
}

.layout__part {
  box-sizing: border-box;
  width: 100%;
  height: 100%;

  opacity: .2;
  border: @layoutThinBorder solid #fff;
  &:first-child {
      border-bottom: none;
  }
}

</document_content>
</document>
<document index="99">
<source>app/src/less/objects2D/loader.less</source>
<document_content>
.loader {
  position: fixed;
  z-index: 11;
  top: 0;
  left: 0;

  display: table;

  width: 100%;
  height: 100%;

  opacity: 1;
  background-color: #0a0a0a;
}

.loader__title {
  position: relative;

  display: table-cell;

  vertical-align: middle;
}

.loader__progress {
  position: absolute;
  bottom: 0;
  left: 0;

  width: 0;
  height: 10px;

  background-color: #fff;
}

</document_content>
</document>
<document index="100">
<source>app/src/less/objects2D/map.less</source>
<document_content>
@import '../mixins/transition';
@import '../mixins/borderRadius';

@nodeSize: 10px;

.map {
  position: fixed;
  z-index: 999;
  top: 50%;
  right: 20px;

  opacity: .5;

  .transition(opacity .3s ease-in-out);
}

.map:hover {
  opacity: 1;
}

.map__node {
  position: relative;
  right: -30px;

  width: @nodeSize;
  height: @nodeSize;
  margin-bottom: @nodeSize;

  cursor: pointer;

  opacity: 0;
  background-color: #222;

  .border-radius(50%);
  .transition(background-color .3s ease-in-out);
}

.map__node__background {
  position: absolute;

  width: 100%;
  height: 100%;

  .border-radius(50%);
  .transition(border 1s ease-in-out, margin 1s ease-in-out);
}

.map__node.is-active {
  background-color: #fff;
}

.map__node.is-active .map__node__background {
  margin-top: -3px;
  margin-left: -3px;

  border: 3px solid #fff;
}

</document_content>
</document>
<document index="101">
<source>app/src/less/objects2D/menu.less</source>
<document_content>
.menu {
  z-index: 10;
  top: 30px;
  left: 30px;

  height: 60px;

  opacity: 0;
}


.menu__button {
  position: absolute;
  top: 50%;

  width: 25px;
  height: 20px;
  margin-top: -10px;

  cursor: pointer;

  opacity: .5;
}

.menu__button__line {
  position: absolute;
  left: 0;

  width: 100%;
  height: 1px;

  background-color: #fff;
}

.menu__button__line--top {
  top: 0;
}

.menu__button__line--middle {
  top: 50%;

  margin-top: -1px;
}

.menu__button__line--bottom {
  bottom: 0;
}

.menu__items {
  display: none;

  margin-left: 25px;
}

.menu__item {
  line-height: 60px;

  margin: 0 20px;

  cursor: pointer;
  text-decoration: none;

  opacity: 0;
  color: #fff;
}

</document_content>
</document>
