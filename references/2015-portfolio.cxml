<document_content>
.inline-block {
  display: -moz-inline-stack;
  display: inline-block;
  zoom: 1;

  vertical-align: top;

  *display: inline;
}

</document_content>
</document>
<document index="92">
<source>app/src/less/mixins/transform.less</source>
<document_content>
.transform (@value) {
  -webkit-transform: @value;
  -moz-transform: @value;
  -ms-transform: @value;
  -o-transform: @value;
  transform: @value;
}

</document_content>
</document>
<document index="93">
<source>app/src/less/mixins/transition.less</source>
<document_content>
.transition (@value1,@value2:X,...) {
  @value: ~`"@{arguments}".replace(/[\[\]]|\,\sX/g, '')`;

  -webkit-transition: @value;
  -moz-transition: @value;
  -ms-transition: @value;
  -o-transition: @value;
  transition: @value;
}
</document_content>
</document>
